{
  "info": {"name":"SmartTask API", "schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key":"baseUrl", "value":"http://localhost:8080"}, {"key":"taskId", "value":"1"}],
  "item": [
    {"name":"Create task", "request":{"method":"POST", "header":[{"key":"Content-Type","value":"application/json"}], "url":"{{baseUrl}}/api/tasks", "body":{"mode":"raw", "raw":"{\"title\":\"Fix API\",\"description\":\"Add tests\",\"priority\":\"HIGH\"}"}}},
    {"name":"Filter tasks", "request":{"method":"GET", "url":"{{baseUrl}}/api/tasks?status=TODO&priority=HIGH"}},
    {"name":"Get task", "request":{"method":"GET", "url":"{{baseUrl}}/api/tasks/{{taskId}}"}},
    {"name":"Update task", "request":{"method":"PUT", "header":[{"key":"Content-Type","value":"application/json"}], "url":"{{baseUrl}}/api/tasks/{{taskId}}", "body":{"mode":"raw","raw":"{\"title\":\"Fix API\",\"description\":\"Reviewed\",\"priority\":\"MEDIUM\"}"}}},
    {"name":"Change status", "request":{"method":"PATCH", "header":[{"key":"Content-Type","value":"application/json"}], "url":"{{baseUrl}}/api/tasks/{{taskId}}/status", "body":{"mode":"raw","raw":"{\"status\":\"IN_PROGRESS\"}"}}},
    {"name":"Delete task", "request":{"method":"DELETE", "url":"{{baseUrl}}/api/tasks/{{taskId}}"}}
  ]
}
